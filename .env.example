# The local app runs on http://localhost:2345 with these optional settings.
LOCAL_DEMO=true
AUTH_URL=http://localhost:2345
# AUTH_SECRET and DATA_ENCRYPTION_KEY may be generated with node:crypto.
# When omitted locally, .data/encryption.key supplies a persistent random key.
# DATA_ENCRYPTION_KEY must be 64 hexadecimal characters.

# PostgreSQL is optional. The default store is .data/medimatch.enc.
# DATABASE_URL=postgresql://medimatch:YOUR_PASSWORD@localhost:5432/medimatch
# REDIS_URL=redis://localhost:6379

# Optional AI service. The website uses its source catalog when unavailable.
# The KELISHUV workbench defaults to the installed local Ollama model.
AI_PROVIDER=OLLAMA
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen3-vl:8b-instruct
AI_EMBEDDING_MODEL=bge-m3
# Run ollama pull bge-m3 to enable local multilingual semantic reranking.
# AI_RAG_EMBEDDINGS=false disables embedding calls and keeps BM25 search.
# AI_PROVIDER can also be RULES or OPENAI_COMPATIBLE.
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=
# AI_TIMEOUT_MS=75000
# AI_MAX_OUTPUT_TOKENS=2200
# OLLAMA_CONTEXT_SIZE=8192

# The earlier legal-chat vector service remains optional.
# FASTAPI_URL=http://127.0.0.1:8000
# AI_SERVICE_KEY=
# OPENAI_API_KEY=
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_BASE_URL=
# LLM_API_KEY=

# Optional encrypted document object storage.
# MINIO_ENDPOINT=http://127.0.0.1:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=medimatch-documents

# Optional real-account email notifications.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Required only for Docker Compose.
# POSTGRES_PASSWORD=
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=

# SMS OTP and dispute invitations. Obtain an Eskiz account and approved sender.
# ESKIZ_TOKEN=
# ESKIZ_SENDER=4546
# APP_PUBLIC_URL=https://your-domain.example

# Hosted identity provider bridge. The JSON and signed webhook contract is in
# docs/KELISHUV_EXPANSION_PLAN.md. Configure the provider-specific bridge for MyID.
# IDENTITY_API_URL=https://your-identity-bridge.example
# IDENTITY_API_KEY=
# IDENTITY_WEBHOOK_SECRET=
# IDENTITY_REDIRECT_HOSTS=your-identity-provider.example

# Payme Merchant API. Callback URL is /api/payments/payme.
# PAYME_MERCHANT_ID=
# PAYME_SECRET=
# PAYME_TEST_MODE=true

# Zoom Server-to-Server OAuth, with meeting create and read permission for this host.
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_HOST_USER_ID=
